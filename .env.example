# MySQL (XAMPP defaults; change user, password, or port for your setup)
DATABASE_URL="mysql://root:@localhost:3306/book_store"

# Auth.js / NextAuth
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Local development administrator created by `npx prisma db seed`
SEED_ADMIN_EMAIL="admin@bookstore.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-local-password"

# Cloudinary (optional: book covers, PDFs, and generated audio)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# OpenRouter (optional: AI summary and chapter audio generation)
OPENAI_API_KEY=""
LLM_MODEL_NAME=""

# Stripe test mode (optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
